{# Generated by Cursor #}
{% macro level3QuantityTooltip(displayQty, commodityCode, chedRef, mrnQty, chedQty, difference, detailsHref, multiChed=false, tooltipTitle="Why this item does not match", chedItems=[]) %}
  <span class="matching-view__today">{{ displayQty }}</span>
  <span class="matching-view__level-3">
    <span class="tooltiplink error" tabindex="0">{{ displayQty }}</span>
    <span class="tooltip tooltip--level-3">
      <strong class="tooltip--level-3__title" id="level-3-mismatch-title-{{ commodityCode }}">{{ tooltipTitle }}</strong>
      {% set refs = chedRef.split(' and ') %}
      {% if refs | length > 1 %}
      <p class="tooltip--level-3__intro tooltip--level-3__lead">The quantity or weight on this item does not match:</p>
      <ul class="tooltip--level-3__refs">
        {% for r in refs %}{% set li = chedItems[loop.index0] %}<li>{% set cid = r | replace('GBCHD2025.', '') %}{% set nums = li.replace(' and ', ', ').split(', ') if li else [] %}<a class="govuk-link" href="#ched-{{ cid }}{% if nums | length %}-item-{{ nums[0] }}{% endif %}"{% if nums | length %} data-highlight="{% for n in nums %}ched-{{ cid }}-item-{{ n }}{% if not loop.last %} {% endif %}{% endfor %}"{% endif %}>{{ r | replace('GBCHD2025.', 'CHEDPP.GB.2025.') }}</a>{% if li %} line {{ 'items' if (',' in li or ' and ' in li) else 'item' }} {{ li }}{% endif %}</li>{% endfor %}
      </ul>
      {% else %}
      {% for r in refs %}{% set li = chedItems[loop.index0] %}<p class="tooltip--level-3__intro">The quantity or weight on this item does not match {% set cid = r | replace('GBCHD2025.', '') %}{% set nums = li.replace(' and ', ', ').split(', ') if li else [] %}<a class="govuk-link" href="#ched-{{ cid }}{% if nums | length %}-item-{{ nums[0] }}{% endif %}"{% if nums | length %} data-highlight="{% for n in nums %}ched-{{ cid }}-item-{{ n }}{% if not loop.last %} {% endif %}{% endfor %}"{% endif %}>{{ r | replace('GBCHD2025.', 'CHEDPP.GB.2025.') }}</a>{% if li %} line {{ 'items' if (',' in li or ' and ' in li) else 'item' }} {{ li }}{% endif %}.</p>{% endfor %}
      {% endif %}
      <p class="tooltip--level-3__intro">Check the quantity on the MRN and the {{ 'CHEDs' if multiChed else 'CHED' }}.</p>
      <table class="tooltip--level-3__table">
        <tbody>
          <tr>
            <th scope="row">Declared on MRN</th>
            <td>{{ mrnQty }}</td>
          </tr>
          <tr>
            <th scope="row">{% if multiChed %}Combined total on CHEDs{% else %}Declared on CHED{% endif %}</th>
            <td>{{ chedQty }}</td>
          </tr>
          <tr class="tooltip--level-3__difference">
            <th scope="row">Difference</th>
            <td><strong>{{ difference }}</strong></td>
          </tr>
        </tbody>
      </table>
      {% if detailsHref %}
        <p class="tooltip--level-3__details">
          <a class="govuk-link" href="{{ detailsHref }}">View details</a>
        </p>
      {% endif %}
    </span>
  </span>
{% endmacro %}
