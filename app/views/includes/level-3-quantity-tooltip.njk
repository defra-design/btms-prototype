{# Generated by Cursor #}
{% macro level3QuantityTooltip(displayQty, commodityCode, chedRef, mrnQty, chedQty, difference, detailsHref) %}
  <span class="matching-view__today">{{ displayQty }}</span>
  <span class="matching-view__level-3">
    <span class="tooltiplink error" tabindex="0">{{ displayQty }}</span>
    <span class="tooltip tooltip--level-3">
      <strong class="tooltip--level-3__title" id="level-3-mismatch-title-{{ commodityCode }}">Why this item does not match</strong>
      <p class="tooltip--level-3__intro">The declared quantity / weight (<strong>{{ displayQty }}</strong>) of this line item does not match CHED reference {{ chedRef }}.</p>
      <table class="tooltip--level-3__table">
        <tbody>
          <tr>
            <th scope="row">Declared on MRN</th>
            <td>{{ mrnQty }}</td>
          </tr>
          <tr>
            <th scope="row">Declared on CHED</th>
            <td>{{ chedQty }}</td>
          </tr>
          <tr class="tooltip--level-3__difference">
            <th scope="row">Difference</th>
            <td><strong>{{ difference }}</strong></td>
          </tr>
        </tbody>
      </table>
      {% if detailsHref %}
        <p class="tooltip--level-3__details">
          <a class="govuk-link" href="{{ detailsHref }}">View details</a>
        </p>
      {% endif %}
    </span>
  </span>
{% endmacro %}
